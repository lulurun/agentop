{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentop-desktop",
  "identifier": "dev.agentop.desktop",
  "version": "2.10.0",
  "build": {
    "beforeDevCommand": "npm run icons",
    "beforeBuildCommand": "npm run icons",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "agentop-desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMUI5QjVDNUYxQjMxQ0IKUldUTE1SdGZYSnNieTMydkhlNWU5VFZvVmd5eWNEWHg5M1U4YXlXeTJ0WlV1L01zRUFZMUpDV0oK",
      "endpoints": [
        "https://github.com/lulurun/agentop/releases/latest/download/latest.json"
      ]
    }
  }
}
